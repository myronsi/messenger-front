{
  "name": "messenger-front",
  "private": true,
  "version": "0.6.12",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "node scripts/dev-mock.mjs",
    "generate:api": "openapi-typescript node_modules/@myronsi/messenger-api/dist/openapi.yaml -o src/shared/api/generated/schema.d.ts",
    "check:contract": "node scripts/check-contract-pin.mjs",
    "backend:up": "bash scripts/backend-up.sh",
    "test:smoke": "playwright test",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "build:mobile": "vite build --mode mobile",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "cap:sync": "npm run build:mobile && cap sync",
    "cap:android": "npm run cap:sync && cap open android",
    "cap:ios": "npm run cap:sync && cap open ios",
    "cap:run:android": "npm run cap:sync && cap run android",
    "cap:run:ios": "npm run cap:sync && cap run ios"
  },
  "dependencies": {
