# Copy to .env.local (ignored by git) for `npm run dev`.

# The v2 API root of the Go backend; scripts/backend-up.sh starts one on this address.
VITE_API_URL=http://127.0.0.1:8080/api/v2
# Optional: where the WebSocket connects, when it is not VITE_API_URL with ws:// or wss://.
# VITE_WS_URL=wss://chat.example.com/api/v2
# Optional: the contract version sent in X-Client-Api-Version; defaults to the installed contract package.
# VITE_CLIENT_API_VERSION=
