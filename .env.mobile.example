# Copy to .env.mobile (or .env.mobile.local) and fill in before running `npm run build:mobile`.
# The native app is served from https://localhost (Android) / capacitor://localhost (iOS),
# so these must be absolute URLs of the production backend.
VITE_BASE_URL=https://chat.example.com/api
# Optional, defaults to the origin of VITE_BASE_URL with ws:// or wss://
VITE_WS_URL=wss://chat.example.com/api
